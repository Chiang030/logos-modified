{
  "name": "logos-vscode",
  "displayName": "LOGOS",
  "description": "A local VS Code workbench with the LOGOS agent core included.",
  "version": "0.1.7",
  "publisher": "logos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chiang030/logos-modified.git",
    "directory": "logos-agent/vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:logos.openChat",
    "onCommand:logos.restartRuntime",
    "onCommand:logos.newSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "logos.openChat",
        "title": "LOGOS: Open Chat",
        "icon": {
          "light": "resources/logos_vscode_icon_512x512.png",
          "dark": "resources/logos_vscode_icon_512x512.png"
        }
      },
      {
        "command": "logos.restartRuntime",
        "title": "LOGOS: Restart Runtime"
      },
      {
        "command": "logos.newSession",
        "title": "LOGOS: New Session"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "logos.openChat",
          "group": "navigation@9",
          "when": "editorLangId != ''"
        }
      ]
    },
    "configuration": {
      "title": "LOGOS",
      "properties": {
        "logos.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start LOGOS automatically when the chat view opens."
        },
        "logos.observability.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Send LOGOS Pi traces through the locally installed LoongSuite Pilot. Pilot controls the destination and content capture. Restart LOGOS after changing this setting."
        },
        "logos.observability.pilotDataDirectory": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute LoongSuite Pilot data directory. Empty uses .loongsuite-pilot in your home directory. Restart LOGOS after changing this setting."
        }
      }
    }
  },
  "files": [
    "dist",
    "resources",
    "runtime",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "build:webview": "node scripts/build-webview.mjs",
    "compile": "npm run clean && npm run typecheck && npm run build:extension && npm run build:webview",
    "test": "vitest run",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "package": "npm run package:win32-x64",
    "package:win32-x64": "npm run prepare:runtime && npm run compile && npm run verify:runtime && npm run smoke:runtime && vsce package --target win32-x64 --out logos-vscode-0.1.7-win32-x64.vsix"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
