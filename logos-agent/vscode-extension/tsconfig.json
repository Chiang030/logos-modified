{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "webview-ui/src/**/*.tsx", "webview-ui/src/**/*.ts", "test/**/*.ts"]
}
