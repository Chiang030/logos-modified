{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "server/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "tests/**/*.ts",
    "../vscode-extension/webview-ui/src/assets.d.ts",
    "worker/**/*.ts"
  ]
}
